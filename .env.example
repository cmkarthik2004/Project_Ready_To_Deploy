# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=production
# Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
COOKIE_SECURE=true
CORS_ORIGINS=["https://finrag.example.org"]
# The first account becomes admin; set ALLOW_REGISTRATION=false afterwards if you want closed sign-up.
ALLOW_REGISTRATION=true
DEFAULT_ROLE=analyst

POSTGRES_USER=finrag
POSTGRES_PASSWORD=
POSTGRES_DB=finrag
# Used when running outside Docker:
DATABASE_URL=postgresql+psycopg://finrag:CHANGE_ME@localhost:5432/finrag
TEST_DATABASE_URL=postgresql+psycopg://finrag:CHANGE_ME@localhost:5432/finrag_test

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Any OpenAI-compatible endpoint (llama.cpp, NVIDIA NIM, vLLM, TensorRT-LLM)
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=qwen3-4b-q4_k_m
LLM_GGUF=Qwen3-4B-Q4_K_M.gguf
LLM_PROVIDER_NAME=llama.cpp (local)
LLM_API_KEY=
LLM_THREADS=4
# NVIDIA hosted NIM: add an endpoint in Settings with base URL https://integrate.api.nvidia.com/v1
# and api_key_env=NVIDIA_API_KEY; the key itself lives only in this environment variable.
NVIDIA_API_KEY=
NGC_API_KEY=

MAX_UPLOAD_MB=50
OCR_ENABLED=true
# pymupdf (default) or docling (requires the separate Docling virtualenv below)
PDF_TABLE_ENGINE=pymupdf
DOCLING_PYTHON=/opt/docling-venv/bin/python
WEB_PORT=3000
# llama.cpp host-RAM prompt cache cap (MiB). The upstream default (8192) can exhaust a 16 GB host.
LLM_CACHE_RAM_MB=1024
